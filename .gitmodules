# Redis MCP
[submodule "external/redis-mcp"]
	path = external/redis-mcp
	url = https://github.com/redis/mcp-redis.git
	ignore = dirty

# ideoforms - Sound synthesis and music generation frameworks
# 🎛 signalflow: real-time sound synthesis, processing and DSP
# 🎵 isobar: generate and manipulate musical patterns
# 🎹 AbletonOSC: control Ableton Live with OSC
# 🔌 pylive: control Ableton Live from Python
# 🔊 python-supercollider: control SuperCollider from Python

[submodule "external/ideoforms/isobar"]
	path = external/ideoforms/isobar
	url = https://github.com/ideoforms/isobar.git
	ignore = dirty

[submodule "external/ideoforms/signalflow"]
	path = external/ideoforms/signalflow
	url = https://github.com/ideoforms/signalflow.git
	ignore = dirty

[submodule "external/ideoforms/pylive"]
