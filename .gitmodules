	url = https://github.com/ideoforms/pylive.git
	ignore = dirty

[submodule "external/ideoforms/python-supercollider"]
	path = external/ideoforms/python-supercollider
	url = https://github.com/ideoforms/python-supercollider.git
	ignore = dirty

[submodule "external/ideoforms/AbletonOSC"]
	path = external/ideoforms/AbletonOSC
	url = https://github.com/ideoforms/AbletonOSC.git
	ignore = dirty

